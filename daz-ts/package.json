{
  "name": "@bluemoonfoundry/daz-ts",
  "version": "0.2.0",
  "description": "TypeScript SDK for the DAZ Studio Script Server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluemoonfoundry/daz-script-server.git",
    "directory": "daz-ts"
  },
  "homepage": "https://github.com/bluemoonfoundry/daz-script-server/tree/master/daz-ts#readme",
  "bugs": {
    "url": "https://github.com/bluemoonfoundry/daz-script-server/issues"
  },
  "keywords": [
    "daz",
    "daz-studio",
    "dazscript",
    "3d",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
