{
    "schemaVersion": 1,
    "id": "hello_package",
    "version": "0.1.0",
    "displayName": "Hello Package",
    "description": "Minimal example .dzpkg for validating the Package Runner end to end.",
    "author": "Package Runner example",

    "entryPoint": "main.py",
    "interactive": true,

    "dependencies": [],

    "inputs": [
        {
            "name": "name",
            "label": "Name",
            "type": "string",
            "default": "world"
        },
        {
            "name": "repeatCount",
            "label": "Repeat Count",
            "type": "int",
            "default": 1,
            "min": 1,
            "max": 10
        }
    ]
}
